GEMINI_MODEL=gemini-3.5-flash

# Comma-separated tab keys to skip loading. Strategy tabs also
# skip the strategy backend (algo1/2/3), so the client build never
# accidentally runs a strategy that isn't in its UI. Empty = load all.
# Valid keys: simple, filter, silver (aka silvermicro), backtest,
# compare, history, calendar, charges. Only strategy keys affect
# the backend; UI-only keys are informational here.
# Example for the client deployment (hides algos not in their build):
#   HIDDEN_TABS=silver,filter,backtest,compare
HIDDEN_TABS=

# Per-deployment suffix that isolates broker_tokens rows when multiple
# backends share ONE Supabase project. Leave empty for single-backend
# setups. Set to a short lowercase identifier when running multiple
# backends against the same Supabase:
#   BROKER_KEY_SUFFIX=client        (client-facing backend)
#   BROKER_KEY_SUFFIX=dev           (developer's own backend)
# The active broker key becomes "fyers_live__<suffix>" so each backend
# reads/writes its own Fyers token without stepping on the others.
BROKER_KEY_SUFFIX=

# algo3 Silver Micro contract override. By default the strategy asks
# Fyers's MCX master file for the nearest-expiry SILVERMIC contract
# and auto-rolls each month. Set this env var to force a specific
# contract instead — useful when Fyers's nearest pick is a weekly
# variant while the client trades the monthly one. Example:
#   SILVER_MICRO_SYMBOL_OVERRIDE=MCX:SILVERMIC31AUGFUT
# Leave empty to keep the auto-rollover behavior.
SILVER_MICRO_SYMBOL_OVERRIDE=
