FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://www.google.com
FYERS_FY_ID=
FYERS_PIN=
FYERS_TOTP_KEY=
FYERS_PROXY_URL=

LIVE_FYERS_CLIENT_ID=
LIVE_FYERS_SECRET_KEY=
LIVE_FYERS_REDIRECT_URI=https://www.google.com
LIVE_FYERS_FY_ID=
LIVE_FYERS_PIN=
LIVE_FYERS_TOTP_KEY=
LIVE_FYERS_PROXY_URL=
PAPER_FYERS_PROXY_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

ALLOWED_ORIGINS=*
FRONTEND_URL=https://your-app.vercel.app
APP_PIN=1402
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Railway/stdout focus. Default delta keeps production logs on Delta/PAXG.
# Set LOG_FOCUS=all temporarily when debugging FYERS or startup noise.
LOG_FOCUS=delta
# Detailed Delta JSON trace lines for price, candle, trigger and order decisions.
DELTA_DEBUG_LOGS=true
# Compact (default): summarize routine traffic every 60s; retain decisions/errors.
# Use verbose temporarily to include every tick and trigger check.
DELTA_LOG_MODE=compact

# Delta paper engine. Paper-only: live Delta account views are read-only,
# and no Delta order-placement endpoint is registered.
DELTA_PAPER_ENABLED=false
DELTA_EXCHANGE=india
DELTA_GOLD_SYMBOL=PAXGUSD
DELTA_SILVER_SYMBOL=SLVONUSD
DELTA_PROXY_URL=
DELTA_API_KEY=
DELTA_API_SECRET=
# Optional comma-separated deployment gate. Empty = show everything.
# Valid keys: delta, gold, silver, overview, activity, backtest,
# gold5m, gold7m, gold15m, gold30m, gold1h, gold4h,
# silveroverview, silveractivity, silverbacktest,
# silver5m, silver15m, silver30m, silver1h, silver4h.
DELTA_HIDDEN_SECTIONS=

# Comma-separated tab keys to skip loading. Strategy tabs also
# skip the strategy backend (algo1/2/3), so the client build never
# accidentally runs a strategy that isn't in its UI. Empty = load all.
# Valid keys: simple, filter, silver (aka silvermicro), backtest,
# compare, history, calendar, charges. Only strategy keys affect
# the backend; UI-only keys are informational here.
# Example for the client deployment (hides algos not in their build):
#   HIDDEN_TABS=silver,filter,backtest,compare
HIDDEN_TABS=

# Per-deployment suffix that isolates broker_tokens rows when multiple
# backends share ONE Supabase project. Leave empty for single-backend
# setups. Set to a short lowercase identifier when running multiple
# backends against the same Supabase:
#   BROKER_KEY_SUFFIX=client        (client-facing backend)
#   BROKER_KEY_SUFFIX=dev           (developer's own backend)
# The active broker key becomes "fyers_live__<suffix>" so each backend
# reads/writes its own Fyers token without stepping on the others.
BROKER_KEY_SUFFIX=

# algo3 Silver Micro contract override. By default the strategy asks
# Fyers's MCX master file for the nearest-expiry SILVERMIC contract
# and auto-rolls each month. Set this env var to force a specific
# contract instead — useful when Fyers's nearest pick is a weekly
# variant while the client trades the monthly one. Example:
#   SILVER_MICRO_SYMBOL_OVERRIDE=MCX:SILVERMIC31AUGFUT
# Leave empty to keep the auto-rollover behavior.
SILVER_MICRO_SYMBOL_OVERRIDE=
