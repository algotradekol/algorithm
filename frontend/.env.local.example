NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Comma-separated tab keys to hide from the dashboard. Must match the
# backend's HIDDEN_TABS env var value on the same deployment or the UI
# will show tabs whose data endpoints 404. Empty = show all tabs.
# Valid keys: simple, filter, silver (aka silvermicro), backtest,
# compare, history, calendar, charges.
# Example for the client deployment:
#   NEXT_PUBLIC_HIDDEN_TABS=silver,filter,backtest,compare
NEXT_PUBLIC_HIDDEN_TABS=
